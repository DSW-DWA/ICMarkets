{
  "ConnectionStrings": {
    "Blockchain": "Data Source=blockchain.db"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/icmarkets-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "ICMarkets.Api"
    }
  },
  "BlockCypher": {
    "BaseUrl": "https://api.blockcypher.com/v1/",
    "Networks": {
      "EthereumMainnet": "eth/main",
      "DashMainnet": "dash/main",
      "BitcoinMainnet": "btc/main",
      "BitcoinTestnet3": "btc/test3",
      "LitecoinMainnet": "ltc/main"
    }
  },
  "HttpResilience": {
    "TotalRequestTimeout": {
      "Timeout": "00:00:35"
    },
    "AttemptTimeout": {
      "Timeout": "00:00:10"
    },
    "Retry": {
      "MaxRetryAttempts": 3,
      "Delay": "00:00:00.500",
      "BackoffType": "Exponential",
      "UseJitter": true
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 5,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:00:15"
    }
  },
  "Collection": {
    "Enabled": true,
    "CollectOnStartup": true,
    "Interval": "00:05:00"
  },
  "Cors": {
    "AllowedOrigins": [ "*" ]
  }
}
